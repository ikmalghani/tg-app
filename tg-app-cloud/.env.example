# --- Telegram (same as desktop tg-app) ---
API_ID=
API_HASH=
BOT_TOKEN=

# Optional: default phone for Browse Channel user login (E.164)
# Example: USER_PHONE=+60123456789
USER_PHONE=

NOOFCHANNEL=2
CHANNELNAME1=
CHANNELID1=
CHANNELNAME2=
CHANNELID2=

# --- Disk guard ---
# Keep this much free space always (bytes). Default 2 GiB.
DISK_RESERVE_BYTES=2147483648
# Work directory inside the container (mounted volume).
DATA_DIR=/data
